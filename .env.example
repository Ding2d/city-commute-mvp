COMMUTE_OUTPUT_DIR=outputs
COMMUTE_ROUTE_COUNT=4
COMMUTE_SENTENCE_COUNT=6
COMMUTE_MIN_CHARS=20
COMMUTE_MAX_CHARS=30
COMMUTE_DATA_PROVIDER=mock
COMMUTE_LLM_PROVIDER=mock
# Set provider to openai_compatible to enable actual paid/external API calls.
COMMUTE_LLM_BASE_URL=https://api.openai.com/v1
COMMUTE_LLM_API_KEY=
COMMUTE_LLM_MODEL=
COMMUTE_LLM_TIMEOUT_SECONDS=30
COMMUTE_LLM_FORMAT_RETRIES=1
COMMUTE_LLM_TEMPERATURE=0.7
COMMUTE_LLM_MAX_TOKENS=1200
COMMUTE_SCORE_LANDMARK_WEIGHT=0.5
COMMUTE_SCORE_SCENARIO_WEIGHT=0.3
COMMUTE_SCORE_FRICTION_WEIGHT=0.2
